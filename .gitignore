# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# backend uploads
backend/data/*
!backend/data/README.md
!backend/data/sample_parcels.geojson

# vercel
.vercel

# Local OpenCode project config (per-user, not shared)
opencode.json
.opencode/skills/

# typescript
*.tsbuildinfo
next-env.d.ts

pm2.config.js

# pdf
*.pdf


