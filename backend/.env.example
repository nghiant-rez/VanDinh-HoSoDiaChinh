# start.ps1 copies this file to .env on first run.
# Keep real credentials only in backend/.env; this template is tracked by Git.

# Replace CHANGE_ME with the URL-encoded password for your PostgreSQL install.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/vandinh"

# Path to the cadastral map data (dc*.txt + dc*.dgn files)
# Leave empty to auto-detect a Ban Do folder on C:, D:, E:, or F:.
# Set an absolute path only when auto-detection cannot find your data.
DGN_SOURCE_PATH=""

# GDAL binaries (for ogr2ogr / gdaltransform)
# start.ps1 also checks common OSGeo4W and QGIS install locations.
GDAL_BIN_PATH="E:\OSGeo4W\bin"
