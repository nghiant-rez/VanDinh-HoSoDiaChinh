generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int        @id @default(autoincrement())
  username      String     @unique
  full_name     String
  password_hash String
  role_id       Int
  is_active     Boolean    @default(true)
  created_at    DateTime   @default(now())

  role          Role       @relation(fields: [role_id], references: [id])
  audit_logs    AuditLog[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // ADMIN, STAFF
  description String?
  users       User[]

  @@map("roles")
}

model Record {
  id                  Int               @id @default(autoincrement())
  ma_ho_so            String            @unique
  ten_ho_so           String
  loai_ho_so          String
  chu_so_huu          String
  storage_location_id Int?
  has_scan            Boolean           @default(false)
  created_by          Int
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  storage_location    StorageLocation?  @relation(fields: [storage_location_id], references: [id])
  parcels             Parcel[]
  scans               Scan[]
  
  // Relations for mutations
  mutations_old       Mutation[]        @relation("OldRecord")
  mutations_new       Mutation[]        @relation("NewRecord")

  @@map("records")
}

model Parcel {
  id         Int      @id @default(autoincrement())
  so_thua    String
  to_ban_do  String
  dien_tich  Float?
  dia_chi    String?
  record_id  Int?
  
  // Note: For PostGIS geometry column, we use raw SQL migrations
  // geometry Unsupported("geometry(Polygon,4326)")?

  record     Record?  @relation(fields: [record_id], references: [id])

  @@map("parcels")
}

model StorageLocation {
  id       Int      @id @default(autoincrement())
  kho      String
  ke       String
  tang     String
  hop_so   String
  records  Record[]

  @@map("storage_locations")
}

model Scan {
  id          Int      @id @default(autoincrement())
  record_id   Int
  file_path   String
  file_name   String
  ocr_text    String?  @db.Text
  ocr_status  String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  uploaded_at DateTime @default(now())

  record      Record   @relation(fields: [record_id], references: [id])

  @@map("scans")
}

model Mutation {
  id             Int      @id @default(autoincrement())
  loai_bien_dong String
  old_record_id  Int?
  new_record_id  Int?
  mo_ta          String?  @db.Text
  created_by     Int
  created_at     DateTime @default(now())

  old_record     Record?  @relation("OldRecord", fields: [old_record_id], references: [id])
  new_record     Record?  @relation("NewRecord", fields: [new_record_id], references: [id])

  @@map("mutations")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  user_id        Int
  action         String   // INSERT, UPDATE, DELETE, EXPORT, LOGIN
  table_name     String?
  record_id_ref  Int?
  details        String?  @db.Text
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}
